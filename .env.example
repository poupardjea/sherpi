# Copier en .env pour le développement (jamais commité).

# PostgreSQL. Absent = données en mémoire, perdues au redémarrage.
# Postgres local sans TLS : ajouter ?sslmode=disable
DATABASE_URL=

# Clé Claude. Absente = classement simple sans modèle.
ANTHROPIC_API_KEY=
