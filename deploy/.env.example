# Copier en deploy/.env sur le serveur (jamais commité).

# Domaine public, déjà pointé vers l'IP du serveur (sans https://).
DOMAIN=demo.mondomaine.fr

# Mot de passe de la base. Le générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# Clé Claude. Vide = classement simple sans modèle.
ANTHROPIC_API_KEY=

# 1 = les boutiques de démo sont rechargées à chaque démarrage (démo publique uniquement).
SEED_DEMO=1
